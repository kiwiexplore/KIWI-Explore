# The daily Liberec digest is written by Claude (see src/brief.mjs).
# Without this key the endpoint answers `configured: false` and the news
# module simply shows its list — nothing else in KIWI needs a key.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Claude Opus 5 by default; set this for a cheaper digest.
# BRIEF_MODEL=claude-haiku-4-5

# A glance at your inbox, read over IMAP by this service (src/mail.mjs).
# Headers only — sender, subject, date, read/unread. Nothing is opened,
# marked, moved or sent.
#
# USE AN APP PASSWORD, not your account password. Gmail:
# myaccount.google.com/apppasswords. Seznam: nastaveni.seznam.cz.
# MAIL_HOST=imap.gmail.com
# MAIL_USER=you@gmail.com
# MAIL_PASSWORD=your-app-password
# MAIL_PORT=993
# MAIL_MAILBOX=INBOX
