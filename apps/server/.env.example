# Your own Anthropic API key — create one at console.anthropic.com
# (Settings > API Keys). Without this, /api/chat responds with a clear
# "not configured" error instead of a real reply.
ANTHROPIC_API_KEY=

# Same value as apps/command-center/.env's VITE_SPOTIFY_CLIENT_ID — not
# actually secret (PKCE apps have no client secret, see spotifyAuth.ts's
# own comment), just needed here too so the backend can refresh tokens.
SPOTIFY_CLIENT_ID=

# Google Calendar + YouTube — create an OAuth 2.0 Client ID at
# console.cloud.google.com (APIs & Services > Credentials), type "Web
# application". Add this exact Authorized redirect URI there:
#   http://localhost:8787/api/google/callback
# (swap the host/port if PORT below or your deployment differs). Also
# enable the "Google Calendar API" and "YouTube Data API v3" under
# APIs & Services > Library — Google 403s otherwise even with valid
# credentials. Unlike Spotify's Client ID, GOOGLE_CLIENT_SECRET is a
# real secret — it stays server-side only, never shipped to the browser.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/api/google/callback

# Video Studio's transcription runs locally: ffmpeg pulls the audio out
# of the recording, whisper.cpp transcribes it. Nothing about a video
# leaves this machine, and no API key is involved in this step. Leave
# the two BIN values unset to use whatever is on PATH.
#   macOS: brew install ffmpeg whisper-cpp
# WHISPER_MODEL has no sensible default — download a model and point at
# it, e.g. ggml-base.bin from huggingface.co/ggerganov/whisper.cpp.
# Until it's set, Video Studio's Transcribe button answers with exactly
# that instruction rather than failing vaguely.
FFMPEG_BIN=
WHISPER_BIN=
WHISPER_MODEL=

# Optional. Leave unset for local/private use — see index.ts's own
# comment on why. Set this before deploying anywhere less private, and
# set the matching VITE_KIWI_API_TOKEN in apps/command-center/.env.
KIWI_API_TOKEN=

PORT=8787

# Only needed for a real deployment — dev already allows any
# localhost/127.0.0.1 origin automatically (see index.ts).
CORS_ORIGIN=
