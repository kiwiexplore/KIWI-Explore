# One Spotify Developer app for the whole deployment — every visitor
# authorizes their own Spotify account against this same app, they
# don't create their own. See developer.spotify.com/dashboard; the
# app's Redirect URI must match this app's own origin exactly
# (shown in the Spotify widget when this isn't set).
VITE_SPOTIFY_CLIENT_ID=

# apps/server — see that app's own .env.example. Defaults match its
# defaults, so local dev needs no changes here.
VITE_KIWI_API_URL=http://localhost:8787
# Only needed once apps/server's KIWI_API_TOKEN is actually set.
VITE_KIWI_API_TOKEN=
